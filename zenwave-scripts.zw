// ZenWave Scripts File (.zw): plugins and configuration for ZenWave SDK code generation.
//
// The models and API contracts are owned by the orders-checkout-api repository and read from
// its raw GitHub URLs (branch main). Nothing is generated into src/main/resources/public/apis:
// the OpenAPI/AsyncAPI contracts are produced in that repository from its domain-model.zdl.
//
// Usage: Play button in the ZenWave IDE plugin, or copy the command line shown on hover.
config {

    zdlFile "https://raw.githubusercontent.com/arcadia-editions/orders-checkout-api/refs/heads/main/domain-model.zdl"
    databaseType postgresql

    layout CleanHexagonalProjectLayout
    // Package properties (openApi*, entities, core, adapters...) are derived from basePackage and the layout.
    // The generated AsyncAPI SDK lives outside the hexagon (asyncapi.provider / asyncapi.client), so the
    // asyncApi* layout values are overridden below. Keep the pom.xml properties openApiApiPackage,
    // openApiModelPackage, asyncApiModelPackage and asyncApiProducerApiPackage in sync with the layout values.
    openApiModelNameSuffix DTO

    plugins {
        /** Generates a Backend Application from the ZDL model. (Headless Core) */
        BackendApplicationDefaultPlugin {
            useLombok false
            useJSpecify true
            includeEmitEventsImplementation true
            layout.asyncApiModelPackage "{{basePackage}}.asyncapi.provider.dtos"
            layout.asyncApiProducerApiPackage "{{basePackage}}.asyncapi.provider"
            layout.asyncApiConsumerApiPackage "{{basePackage}}.asyncapi.provider"
            // --force // overwite all files
        }
        /** Generates Spring MVC controllers from the OpenAPI specification (Web Adapters). */
        OpenAPIControllersPlugin {
            openapiFile "https://raw.githubusercontent.com/arcadia-editions/orders-checkout-api/refs/heads/main/openapi.yml"
        }
        /** Generates API tests from the OpenAPI specification. */
        SpringWebTestClientPlugin {
            openapiFile "https://raw.githubusercontent.com/arcadia-editions/orders-checkout-api/refs/heads/main/openapi.yml"
        }
    }
}
